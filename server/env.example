# העתק ל-server/.env.local (לא נכנס ל-git)

# שרת
NODE_ENV=development
SERVER_HOST=127.0.0.1
SERVER_PORT=8787

# CORS — מקורות מ-front (Vite)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Firebase Admin — אחת מהאפשרויות (חובה לסנכרון Morning)
# FIREBASE_SERVICE_ACCOUNT_PATH=../secrets/firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# FIREBASE_SERVICE_ACCOUNT_B64=...   ← מומלץ ל-xCloud (node scripts/encode-firebase-sa.mjs)

# Morning (חשבונית ירוקה) — אופציונלי כאן; אפשר גם להזין דרך כפתור באפליקציה
# (אם מוגדר כאן — גובר על מה שנשמר ב-Firestore)
# MORNING_ENV=production
# MORNING_KEY_ID=
# MORNING_KEY_SECRET=

# סנכרון — מאיזה תאריך למשוך מסמכים (כולל), וכמה ימי חפיפה
SYNC_FROM_DATE=2026-03-01
SYNC_OVERLAP_DAYS=7
