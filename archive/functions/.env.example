# העתק ל־`functions/.env` (ערכים לא-סודיים) ול־`functions/.env.local` (RESEND_API_KEY + MAIL_FROM למחשב מקומי בלבד).
# הסודות לא ב-`.env` כדי שלא Firebase יפרוס אותם כ-env רגיל — מתנגש עם Secret Manager.

# Resend — HTTPS API (מומלץ בפרודקשן). הסודות נרשמים ב-Secret Manager:
#   firebase functions:secrets:set RESEND_API_KEY
#   firebase functions:secrets:set MAIL_FROM
# sendAssigneeTaskNotification משתמש ב-defineSecret('RESEND_API_KEY'|'MAIL_FROM') וב-onCall({ secrets: [...] }).
RESEND_API_KEY=
# דוגמה דומיין מאומת: Hub POS <no-reply@pos.hub.co.il>
MAIL_FROM=

SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=
SMTP_SECURE=false
APP_PUBLIC_URL=https://hub-pos-f399c.web.app
